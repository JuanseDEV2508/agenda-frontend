# URL base del backend de agenda (incluye el prefijo de versión).
# Sólo la usa el servidor de Next: el navegador nunca la ve.
API_BASE_URL=http://localhost:8000/api/v1

# Secreto para cifrar la cookie de sesión (AES-256-GCM). Mínimo 32 caracteres.
# Genera uno con:  openssl rand -base64 32
AUTH_SECRET=cambia-este-valor-por-uno-generado-de-32-caracteres-o-mas

# No añadas aquí tokens, contraseñas ni claves reales.
# Nunca uses el prefijo NEXT_PUBLIC_ para secretos: se incluyen en el bundle.
